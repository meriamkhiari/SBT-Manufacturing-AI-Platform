# Smart Brain Technology - Environment Variables Configuration
# Copy this file to .env and fill in your actual keys

# API Keys
OPENROUTER_KEY=your_openrouter_key_here
GEMINI_KEY=your_gemini_key_here

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cable_db
MONGO_COLL=terminals
HISTORY_COLL=user_history

# MCP Configuration
MCP_BIN=mongodb-mcp-server

# Flask
FLASK_SECRET_KEY=dev-secret-key-change-me
